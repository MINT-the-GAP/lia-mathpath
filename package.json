{
  "name": "lia-mathpath",
  "version": "0.0.18",
  "description": "LiaScript plugin for reusable math path components",
  "scripts": {
    "build": "parcel build src/index.ts --dist-dir dist --no-scope-hoist && node scripts/version-bundle.mjs",
    "preview": "npx http-server . -p 8000 --cors",
    "test": "npm run build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test",
    "test:browser": "node scripts/browser-check.mjs && node scripts/browser-check.mjs --consumer-import",
    "test:browser:remote": "node scripts/browser-check.mjs --remote",
    "test:browser:remote-release": "node scripts/remote-release-browser-check.mjs",
    "test:browser:adetails": "node scripts/adetails-browser-check.mjs",
    "test:browser:lernpfad": "node scripts/lernpfad-browser-check.mjs",
    "test:browser:lernpfad-generation": "node scripts/lernpfad-generation-browser-check.mjs",
    "test:browser:lernpfad-stress": "node scripts/lernpfad-stress-browser-check.mjs"
  },
  "keywords": [
    "liascript",
    "oer",
    "typescript",
    "math"
  ],
  "author": "MINT-the-GAP",
  "license": "MIT",
  "browserslist": [
    "Chrome >= 88",
    "Edge >= 88",
    "Firefox >= 85",
    "Safari >= 14",
    "iOS >= 14"
  ],
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "jsdom": "^26.1.0",
    "parcel": "^2.15.4",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "katex": "^0.17.0"
  }
}
